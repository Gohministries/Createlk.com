export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;

    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders()
      });
    }

    try {
      // =========================================
      // API STATUS
      // =========================================
      if (path === "/" && request.method === "GET") {
        return json({
          success: true,
          message: "CreateLK Academy API is running.",
          services: {
            database: !!env.DB,
            receipt_storage: !!env.RECEIPT,
            workers_ai: !!env.AI
          }
        });
      }

      // =========================================
      // REGISTER
      // =========================================
      if (path === "/register" && request.method === "POST") {
        return await register(request, env);
      }

      // =========================================
      // LOGIN
      // =========================================
      if (path === "/login" && request.method === "POST") {
        return await login(request, env);
      }

      // =========================================
      // PAYHERE CREATE
      // Supports:
      // /payhere/create
      // /create-payhere
      // =========================================
      if (
        (path === "/payhere/create" ||
          path === "/create-payhere") &&
        request.method === "POST"
      ) {
        return await createPayHere(request, env);
      }

      // =========================================
      // PAYHERE NOTIFICATION
      // =========================================
      if (
        path === "/payhere-notify" &&
        request.method === "POST"
      ) {
        return await payHereNotify(request, env);
      }

      // =========================================
      // BANK PAYMENT
      // =========================================
      if (
        path === "/bank-payment" &&
        request.method === "POST"
      ) {
        return await bankPayment(request, env);
      }

      // =========================================
      // MEMBERSHIP
      // =========================================
      if (
        path === "/membership" &&
        request.method === "GET"
      ) {
        return await membership(request, env);
      }

      // =========================================
      // AI
      // =========================================
      if (
        path === "/ai" &&
        request.method === "POST"
      ) {
        return await ai(request, env);
      }

      // =========================================
      // 404
      // =========================================
      return json(
        {
          success: false,
          message: "Route not found.",
          path
        },
        404
      );

    } catch (error) {
      console.error("Worker error:", error);

      return json(
        {
          success: false,
          message: "Server error.",
          error: error?.message || "Unknown error"
        },
        500
      );
    }
  }
};


// =========================================
// CORS
// =========================================

function corsHeaders() {
  return {
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods":
      "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers":
      "Content-Type",
    "Content-Type":
      "application/json"
  };
}


// =========================================
// JSON
// =========================================

function json(data, status = 200) {
  return new Response(
    JSON.stringify(data),
    {
      status,
      headers: corsHeaders()
    }
  );
}


// =========================================
// MD5
// =========================================

async function md5(text) {
  const data =
    new TextEncoder().encode(text);

  const hash =
    await crypto.subtle.digest(
      "MD5",
      data
    );

  return [...new Uint8Array(hash)]
    .map(
      b =>
        b.toString(16)
         .padStart(2, "0")
    )
    .join("");
}


// =========================================
// REGISTER
// =========================================

async function register(request, env) {

  const body =
    await request.json();

  const first_name =
    String(
      body.first_name || ""
    ).trim();

  const last_name =
    String(
      body.last_name || ""
    ).trim();

  const email =
    String(
      body.email || ""
    )
      .trim()
      .toLowerCase();

  const phone =
    String(
      body.phone || ""
    ).trim();

  const password =
    String(
      body.password || ""
    );

  if (
    !first_name ||
    !last_name ||
    !email ||
    !phone ||
    !password
  ) {
    return json(
      {
        success: false,
        message:
          "Please complete all required fields."
      },
      400
    );
  }

  const existing =
    await env.DB
      .prepare(
        `SELECT id
         FROM students
         WHERE email = ?`
      )
      .bind(email)
      .first();

  if (existing) {
    return json(
      {
        success: false,
        message:
          "An account with this email already exists."
      },
      409
    );
  }

  const passwordHash =
    await md5(password);

  const result =
    await env.DB
      .prepare(`
        INSERT INTO students
        (
          first_name,
          last_name,
          email,
          phone,
          password_hash,
          membership_status
        )
        VALUES
        (?, ?, ?, ?, ?, 'inactive')
      `)
      .bind(
        first_name,
        last_name,
        email,
        phone,
        passwordHash
      )
      .run();

  return json({
    success: true,
    message:
      "Account created successfully.",
    student_id:
      result.meta.last_row_id
  });
}


// =========================================
// LOGIN
// =========================================

async function login(request, env) {

  const body =
    await request.json();

  const email =
    String(
      body.email || ""
    )
      .trim()
      .toLowerCase();

  const password =
    String(
      body.password || ""
    );

  if (!email || !password) {
    return json(
      {
        success: false,
        message:
          "Email and password are required."
      },
      400
    );
  }

  const passwordHash =
    await md5(password);

  const student =
    await env.DB
      .prepare(`
        SELECT
          id,
          first_name,
          last_name,
          email,
          phone,
          membership_status,
          membership_expiry
        FROM students
        WHERE email = ?
        AND password_hash = ?
      `)
      .bind(
        email,
        passwordHash
      )
      .first();

  if (!student) {
    return json(
      {
        success: false,
        message:
          "Invalid email or password."
      },
      401
    );
  }

  // Automatically mark expired memberships inactive
  if (
    student.membership_status === "active" &&
    student.membership_expiry &&
    new Date(
      student.membership_expiry
    ) <= new Date()
  ) {

    await env.DB
      .prepare(`
        UPDATE students
        SET membership_status = 'inactive'
        WHERE id = ?
      `)
      .bind(student.id)
      .run();

    student.membership_status =
      "inactive";
  }

  return json({
    success: true,
    message:
      "Login successful.",
    student
  });
}


// =========================================
// CREATE PAYHERE
// =========================================

async function createPayHere(request, env) {

  const body =
    await request.json();

  const studentId =
    Number(
      body.student_id
    );

  if (!studentId) {
    return json(
      {
        success: false,
        message:
          "Student ID is required."
      },
      400
    );
  }

  const student =
    await env.DB
      .prepare(`
        SELECT
          id,
          first_name,
          last_name,
          email,
          phone
        FROM students
        WHERE id = ?
      `)
      .bind(studentId)
      .first();

  if (!student) {
    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );
  }

  const merchantId =
    env.PAYHERE_MERCHANT_ID;

  const merchantSecret =
    env.PAYHERE_MERCHANT_SECRET;

  if (
    !merchantId ||
    !merchantSecret
  ) {
    return json(
      {
        success: false,
        message:
          "PayHere configuration is missing."
      },
      500
    );
  }

  const orderId =
    "CLA-" +
    Date.now() +
    "-" +
    studentId;

  const amount =
    "1500.00";

  const currency =
    "LKR";

  const hashedSecret =
    (
      await md5(
        merchantSecret
      )
    ).toUpperCase();

  const hash =
    (
      await md5(
        merchantId +
        orderId +
        amount +
        currency +
        hashedSecret
      )
    ).toUpperCase();

  await env.DB
    .prepare(`
      INSERT INTO payments
      (
        student_id,
        payment_method,
        amount,
        order_id,
        status
      )
      VALUES
      (?, 'payhere', ?, ?, 'pending')
    `)
    .bind(
      studentId,
      1500,
      orderId
    )
    .run();

  /*
   * Your frontend can use these values
   * to submit the PayHere checkout form.
   */

  return json({
    success: true,

    payment: {
      merchant_id:
        merchantId,

      return_url:
        "https://createlk.com/payment.html?status=return",

      cancel_url:
        "https://createlk.com/payment.html?status=cancel",

      notify_url:
        "https://square-term-22bf.gateofheavensl1.workers.dev/payhere-notify",

      first_name:
        student.first_name,

      last_name:
        student.last_name,

      email:
        student.email,

      phone:
        student.phone,

      address:
        "Sri Lanka",

      city:
        "Sri Lanka",

      country:
        "Sri Lanka",

      order_id:
        orderId,

      items:
        "CreateLK Academy Premium - 30 Days",

      currency:
        currency,

      amount:
        amount,

      hash:
        hash
    }
  });
}


// =========================================
// PAYHERE NOTIFICATION
// =========================================

async function payHereNotify(
  request,
  env
) {

  const form =
    await request.formData();

  const merchantId =
    String(
      form.get(
        "merchant_id"
      ) || ""
    );

  const orderId =
    String(
      form.get(
        "order_id"
      ) || ""
    );

  const paymentId =
    String(
      form.get(
        "payment_id"
      ) || ""
    );

  const payhereAmount =
    String(
      form.get(
        "payhere_amount"
      ) || ""
    );

  const currency =
    String(
      form.get(
        "payhere_currency"
      ) || ""
    );

  const statusCode =
    String(
      form.get(
        "status_code"
      ) || ""
    );

  const receivedSignature =
    String(
      form.get(
        "md5sig"
      ) || ""
    );

  if (
    merchantId !==
    env.PAYHERE_MERCHANT_ID
  ) {
    return new Response(
      "Invalid merchant",
      { status: 400 }
    );
  }

  const hashedSecret =
    (
      await md5(
        env.PAYHERE_MERCHANT_SECRET
      )
    ).toUpperCase();

  const localSignature =
    (
      await md5(
        merchantId +
        orderId +
        payhereAmount +
        currency +
        statusCode +
        hashedSecret
      )
    ).toUpperCase();

  if (
    localSignature !==
    receivedSignature
  ) {
    return new Response(
      "Invalid signature",
      { status: 400 }
    );
  }

  const payment =
    await env.DB
      .prepare(`
        SELECT *
        FROM payments
        WHERE order_id = ?
      `)
      .bind(orderId)
      .first();

  if (!payment) {
    return new Response(
      "Payment not found",
      { status: 404 }
    );
  }

  // PayHere status 2 = successful
  if (statusCode === "2") {

    const expiry =
      new Date();

    expiry.setDate(
      expiry.getDate() + 30
    );

    await env.DB
      .prepare(`
        UPDATE payments
        SET
          status = 'paid',
          payhere_payment_id = ?,
          verified_at =
            CURRENT_TIMESTAMP
        WHERE order_id = ?
      `)
      .bind(
        paymentId,
        orderId
      )
      .run();

    await env.DB
      .prepare(`
        UPDATE students
        SET
          membership_status = 'active',
          membership_expiry = ?
        WHERE id = ?
      `)
      .bind(
        expiry.toISOString(),
        payment.student_id
      )
      .run();

    console.log(
      "Premium activated:",
      payment.student_id
    );

  } else {

    await env.DB
      .prepare(`
        UPDATE payments
        SET status = ?
        WHERE order_id = ?
      `)
      .bind(
        "failed",
        orderId
      )
      .run();
  }

  return new Response(
    "OK",
    { status: 200 }
  );
}


// =========================================
// BANK PAYMENT
// =========================================

async function bankPayment(
  request,
  env
) {

  const form =
    await request.formData();

  const studentId =
    Number(
      form.get(
        "student_id"
      )
    );

  const reference =
    String(
      form.get(
        "payment_reference"
      ) ||
      form.get(
        "reference"
      ) ||
      ""
    ).trim();

  const receipt =
    form.get(
      "receipt"
    );

  if (!studentId) {
    return json(
      {
        success: false,
        message:
          "Student ID is required."
      },
      400
    );
  }

  if (!reference) {
    return json(
      {
        success: false,
        message:
          "Payment reference is required."
      },
      400
    );
  }

  if (
    !receipt ||
    typeof receipt.arrayBuffer !==
      "function"
  ) {
    return json(
      {
        success: false,
        message:
          "Please upload your payment receipt."
      },
      400
    );
  }

  // Maximum 10 MB
  if (
    receipt.size >
    10 * 1024 * 1024
  ) {
    return json(
      {
        success: false,
        message:
          "Receipt must be smaller than 10 MB."
      },
      400
    );
  }

  const student =
    await env.DB
      .prepare(`
        SELECT id
        FROM students
        WHERE id = ?
      `)
      .bind(studentId)
      .first();

  if (!student) {
    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );
  }

  const safeName =
    String(
      receipt.name ||
      "receipt"
    )
      .replace(
        /[^a-zA-Z0-9._-]/g,
        "_"
      );

  const receiptKey =
    "receipts/" +
    studentId +
    "/" +
    Date.now() +
    "-" +
    safeName;

  // Upload to R2
  await env.RECEIPT.put(
    receiptKey,
    await receipt.arrayBuffer(),
    {
      httpMetadata: {
        contentType:
          receipt.type ||
          "application/octet-stream"
      }
    }
  );

  // Save payment in D1
  await env.DB
    .prepare(`
      INSERT INTO payments
      (
        student_id,
        payment_method,
        amount,
        payment_reference,
        receipt_key,
        status
      )
      VALUES
      (?, 'bank', 1500, ?, ?, 'pending')
    `)
    .bind(
      studentId,
      reference,
      receiptKey
    )
    .run();

  return json({
    success: true,
    message:
      "Bank payment submitted successfully. Your payment will be reviewed before Premium access is activated."
  });
}


// =========================================
// MEMBERSHIP
// =========================================

async function membership(
  request,
  env
) {

  const url =
    new URL(request.url);

  const studentId =
    Number(
      url.searchParams.get(
        "student_id"
      )
    );

  if (!studentId) {
    return json(
      {
        success: false,
        message:
          "Student ID is required."
      },
      400
    );
  }

  const student =
    await env.DB
      .prepare(`
        SELECT
          id,
          first_name,
          last_name,
          email,
          membership_status,
          membership_expiry
        FROM students
        WHERE id = ?
      `)
      .bind(studentId)
      .first();

  if (!student) {
    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );
  }

  let active = false;

  if (
    student.membership_status ===
      "active" &&
    student.membership_expiry
  ) {

    active =
      new Date(
        student.membership_expiry
      ) > new Date();

    // Automatically expire membership
    if (!active) {

      await env.DB
        .prepare(`
          UPDATE students
          SET membership_status =
            'inactive'
          WHERE id = ?
        `)
        .bind(studentId)
        .run();

      student.membership_status =
        "inactive";
    }
  }

  return json({
    success: true,
    active,
    student
  });
}


// =========================================
// WORKERS AI
// =========================================

async function ai(
  request,
  env
) {

  if (!env.AI) {
    return json(
      {
        success: false,
        message:
          "Workers AI binding is not available."
      },
      500
    );
  }

  const body =
    await request.json();

  const prompt =
    String(
      body.prompt || ""
    ).trim();

  if (!prompt) {
    return json(
      {
        success: false,
        message:
          "Prompt is required."
      },
      400
    );
  }

  /*
   * Basic membership protection.
   * Free users should not use premium AI
   * unless you intentionally allow it.
   */

  const studentId =
    Number(
      body.student_id
    );

  if (!studentId) {
    return json(
      {
        success: false,
        message:
          "Student ID is required."
      },
      400
    );
  }

  const student =
    await env.DB
      .prepare(`
        SELECT
          id,
          membership_status,
          membership_expiry
        FROM students
        WHERE id = ?
      `)
      .bind(studentId)
      .first();

  if (!student) {
    return json(
      {
        success: false,
        message:
          "Student not found."
      },
      404
    );
  }

  const active =
    student.membership_status ===
      "active" &&
    student.membership_expiry &&
    new Date(
      student.membership_expiry
    ) > new Date();

  if (!active) {
    return json(
      {
        success: false,
        message:
          "Active Premium membership is required for this AI feature."
      },
      403
    );
  }

  const result =
    await env.AI.run(
      "@cf/meta/llama-3.1-8b-instruct",
      {
        messages: [
          {
            role: "system",
            content:
              "You are CreateLK Academy's English learning assistant. Help students learn English clearly and practically."
          },
          {
            role: "user",
            content: prompt
          }
        ]
      }
    );

  return json({
    success: true,
    response:
      result?.response ||
      result
  });
}